# AI Scraping Configuration
# Add your API keys here and rename this file to .env

# OpenAI API Key (for AI-powered content extraction)
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Use local LLM (Ollama) - set to true to use local instead of OpenAI
USE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://localhost:11434

# Scraping Configuration
MAX_LISTINGS_PER_SITE=20
SCRAPING_TIMEOUT=30
